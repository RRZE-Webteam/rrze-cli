<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap-unit.php" cacheDirectory=".phpunit.cache/unit"
         colors="true" failOnWarning="true" failOnRisky="true" failOnNotice="true">
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
    </testsuites>
    <source><include><directory suffix=".php">includes</directory></include></source>
</phpunit>
